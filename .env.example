# VitalsSync Environment Configuration Template
# Copy this file to .env in your respective service directories (backend/.env, frontend/.env)

# ==========================================
# BACKEND CONFIGURATION (backend/.env)
# ==========================================
PORT=5001
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here_change_in_production
SOCKET_CORS_ORIGIN=*

# ==========================================
# FRONTEND CONFIGURATION (frontend/.env)
# ==========================================
VITE_API_URL=http://localhost:5001
VITE_SOCKET_URL=http://localhost:5001

# ==========================================
# MOBILE CONFIGURATION (mobile/lib/core/constants/api_constants.dart)
# ==========================================
# iOS Simulator: http://localhost:5001/api
# Android Emulator: http://10.0.2.2:5001/api
# Physical Device: http://YOUR_LOCAL_IP:5001/api
